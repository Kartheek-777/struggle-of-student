# Django Core Settings
# A secure, random 50+ char secret key is required when DEBUG=False
SECRET_KEY=your-django-production-secret-key-min-32-chars-long
DEBUG=False

# Host & Reverse-Proxy Settings
# Comma-separated list of allowed hostnames (e.g. your-app.onrender.com,api.yourdomain.com)
# Note: On Render, RENDER_EXTERNAL_HOSTNAME is automatically detected and added.
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.onrender.com
# RENDER_EXTERNAL_HOSTNAME=your-backend.onrender.com

# Database Settings (MySQL Engine)
DB_NAME=struggle_of_student
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
# Optional: Cloud managed MySQL connection URI (alternative to DB_* individual vars)
# DATABASE_URL=mysql://user:password@host:3306/struggle_of_student
# Optional: Path to SSL Certificate Authority bundle if required by your cloud MySQL provider
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# CORS Settings (Allow Vercel frontend to communicate with API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
# Optional: Regex pattern for Vercel preview branch deployments
# CORS_ALLOWED_ORIGIN_REGEXES=https://.*\.vercel\.app

# CSRF Trusted Origins (Comma-separated HTTPS origins for state-changing requests)
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com

# Optional Production Security Overrides
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_ENABLE=False

